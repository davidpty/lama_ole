# lama_ole.env.example — reference config with every supported variable.
#
# Copy this file to either location (you do NOT need both):
#   ~/.config/lama_ole/lama_ole.env   # user-wide default
#   ./lama_ole.env                    # per-project override (wins over user)
#
# Precedence: shell env vars > project file > user file. Empty values are
# ignored, so setting LAMA_OLE_MODEL= in the shell blocks the config value.
#
# Syntax: one `KEY=value` per line, `#` comments allowed, values may be
# quoted ("..." — quotes are stripped). Every line below is COMMENTED OUT on
# purpose: copying the file changes nothing; uncomment only what you need.
# Booleans accept 1/true/yes/on and 0/false/no/off (case-insensitive).
# List variables accept space- or comma-separated values.
#
# --------------------------------------------------------------------------
# 1. Backend hosts
# --------------------------------------------------------------------------

# Host of the Ollama server. Same as --ollama-host / --host.
# Legacy name LAMA_OLE_HOST is still honored with a deprecation warning.
#LAMA_OLE_HOST_OLLAMA=http://localhost:11434

# Host of the llama.cpp llama-server. Same as --llamacpp-host.
# Legacy name LAMA_OLE_LLAMACPP_HOST is still honored (deprecated).
#LAMA_OLE_HOST_LLAMACPP=http://localhost:8080

# Bearer token for a llama.cpp server configured with an API key.
# Legacy name LAMA_OLE_LLAMACPP_API_KEY is still honored (deprecated).
#LAMA_OLE_HOST_LLAMACPP_API_KEY=secret-token

# Auto-start a llama-server when none answers at a LOCAL llama.cpp host (this
# also powers /model completion). Only applies to loopback hosts (localhost /
# 127.0.0.1 / ::1) — a remote llama.cpp server is never shadowed by a local
# spawn. The server is always started in router mode, serving the llama.cpp
# cache ($LLAMA_CACHE or ~/.cache/llama.cpp) and LAMA_OLE_LLAMACPP_MODELS_DIR,
# so /model lists every served model. An `owner/name[:quant]` Hugging Face id
# is served only once the server lists it (checked via its /v1/models); a
# missing model prints a one-time notice (download it with
# `llama-server --hf-repo owner/name:quant`). Same as
# --llamacpp-autostart / --no-llamacpp-autostart.
#LAMA_OLE_LLAMACPP_AUTOSTART=true

# Path to the llama-server binary. Default: found on PATH.
#LAMA_OLE_LLAMACPP_BIN=/usr/local/bin/llama-server

# Directory of GGUF models served by an autostarted router. Default: the
# llama.cpp cache ($LLAMA_CACHE or ~/.cache/llama.cpp).
#LAMA_OLE_LLAMACPP_MODELS_DIR=/path/to/models

# Extra arguments passed to an autostarted llama-server (shell-quoted).
#LAMA_OLE_LLAMACPP_ARGS=--threads 4

# Kill an autostarted llama-server when lama_ole exits (default: leave it
# running so later runs reuse it instantly).
#LAMA_OLE_LLAMACPP_STOP_ON_EXIT=false

# --------------------------------------------------------------------------
# 2. Model & generation
# --------------------------------------------------------------------------

# Default model. Backend is chosen from the name: `ollama.<name>` routes to
# Ollama, `llamacpp.<name>` (or a path/GGUF) to llama.cpp, a bare name to
# Ollama. Same as -m / --model.
#LAMA_OLE_MODEL=ollama.gemma2:2b

# Output the model's thinking stream to the console. Same as -t / --thinking.
#LAMA_OLE_THINKING=false

# Sampling temperature. Same as --temperature.
#LAMA_OLE_TEMPERATURE=0.0

# Context window size (e.g. 4096 ... 1048576). Same as --num_ctx.
# NOTE: ignored by the llama.cpp backend (the server sets its own n_ctx).
#LAMA_OLE_NUM_CTX=32768

# GPU layers to offload (Ollama). Same as --num_gpu. Ignored by llama.cpp.
#LAMA_OLE_NUM_GPU=0

# How long the model stays loaded in memory, e.g. '5m', '1h' or seconds.
# Same as --keep_alive. Ignored by llama.cpp.
#LAMA_OLE_KEEP_ALIVE=10h

# --------------------------------------------------------------------------
# 3. Behavior & output
# --------------------------------------------------------------------------

# Start in interactive chat REPL mode. Same as --chat.
#LAMA_OLE_CHAT=false

# Verbosity level (integer). Same as -v (CLI -v adds to it).
#LAMA_OLE_VERBOSE=0

# Colorization of input/thinking/output: auto (TTY only), always, never/none.
# Same as --color.
#LAMA_OLE_COLOR=auto

# Show a colored unified diff of each file write. Same as --diff.
#LAMA_OLE_SHOW_DIFF=true

# Enable user confirmation before dangerous tool operations. Same as --safe.
#LAMA_OLE_SAFE=false

# Chat agent mode: 'build' (full tools, changes allowed) or 'plan' (write
# tools blocked until /build). Same as --mode.
#LAMA_OLE_MODE=build

# Activate Ollama's built-in web search tool. Same as --ollama_websearch.
# Skipped with a warning by the llama.cpp backend (unsupported).
#LAMA_OLE_OLLAMA_WEBSRCH=false

# Custom system prompt. Same as --system_prompt.
#LAMA_OLE_SYSTEM_PROMPT=You are a helpful assistant.

# System prompt read from a file. Same as --system_prompt_file.
#LAMA_OLE_SYSTEM_PROMPT_FILE=/path/to/system-prompt.txt

# --------------------------------------------------------------------------
# 4. Context window meter & auto-compaction
# --------------------------------------------------------------------------

# Show the live context-usage meter in chat. Same as --ctx-meter.
#LAMA_OLE_CTX_METER=true

# Force the meter's context window (no flag). Defaults to --num_ctx or the
# running model's reported context length.
#LAMA_OLE_CTX_SIZE=32768

# Auto-compact the context when it nears the limit. Same as --auto-compact.
#LAMA_OLE_AUTO_COMPACT=false

# Fraction of the context window that triggers compaction (must be in (0, 1]).
# Same as --auto-compact-threshold. Default: 0.75.
#LAMA_OLE_AUTO_COMPACT_THRESHOLD=0.75

# Model used to produce compaction summaries (falls back to the chat model).
# Same as --auto-compact-model.
#LAMA_OLE_AUTO_COMPACT_MODEL=ollama.qwen3:32b

# --------------------------------------------------------------------------
# 5. Tools, skills, vision & tool-call limits
# --------------------------------------------------------------------------

# Tool modules to load (space/comma separated). Same as --tool (CLI appends,
# deduplicated). Use --ignore-config-tools to use only CLI values.
#LAMA_OLE_TOOL=tools.edit tools.dev_tools_readonly tools.web_tools tools.git_readonly tools.run_command

# Skill files whose text is loaded into the system role (space separated).
# Same as --skill (CLI appends, deduplicated).
#LAMA_OLE_SKILL=skills/code-reviewer.md skills/german-assistant.md

# Vision models for media understanding tools. Same as --vision_model
# (CLI replaces this value entirely when given).
#LAMA_OLE_VISION_MODEL=gemma3 llava

# Maximum number of tool-calling rounds per turn (unlimited when unset).
# Same as --max_tool_rounds.
#LAMA_OLE_MAX_TOOL_ROUNDS=10

# Behavior when the limit is reached: 'ask' (interactive menu) or 'fallback'
# (silent default). Same as --max_tool_rounds_continuation.
#LAMA_OLE_MAX_TOOL_ROUNDS_CONTINUATION=ask

# --------------------------------------------------------------------------
# 6. Sessions & history
# --------------------------------------------------------------------------

# Automatically resume the most recent session for the current directory on
# startup. Same as --resume.
#LAMA_OLE_RESUME=true

# Automatically save the chat session to disk after every turn and on exit.
# Same as --autosave.
#LAMA_OLE_AUTOSAVE=true

# Sessions directory (default: XDG data home, e.g.
# ~/.local/share/lama_ole/sessions). No flag.
#LAMA_OLE_SESSION_DIR=/path/to/sessions

# Line templates for each view. No flag.
# Format: [{num}] {t}{role}: {text}; tokens: {num} entry number, {t} HH:MM:SS
# short time, {ts} full [<date> <time>] , {role} label, {text} text, {tool} and
# {args} for tool entries. Per-entry-type overrides are separated by
# semicolons; `name.<role>=<label>` pairs rename the labels shown behind the
# {role} token (roles: user, assistant, thinking, toolcall, tool, compacted).
# Unset types keep the default.

# Per-view override for /history. Only the types/names it mentions change.
#LAMA_OLE_FORMAT_HISTORY=[{num}] {t}{role}: {text}

# Per-view override for session replay. Only the types/names it mentions change.
#LAMA_OLE_FORMAT_REPLAY=[{num}] {t}{role}: {text}

# Live assistant output in --chat. Defaults to the same header as the other
# views ([{num}] {t}{role}: {text}); set to {text} for raw streamed output.
#LAMA_OLE_FORMAT_OUTPUT={text}

# Rename the role labels shown behind the {role} token (built-in defaults are
# You, Me, thinking, tools, tool result, summary).
#LAMA_OLE_FORMAT_HISTORY="name.user=Me;name.assistant=Bot;name.thinking=Bot (thinking);name.toolcall=Bot (tools);name.tool=TOOL RESULT;name.compacted=COMPACTED"

# --------------------------------------------------------------------------
# 7. Color theme (config-only, no flags)
# --------------------------------------------------------------------------
# Each accepts a comma-separated color spec: named color (black...white,
# bright_*), a 256-color number (0-255), hex (#rrggbb), and/or attributes
# (bold, italic, underline, dim, reverse). Examples: bold,green, #ff8700,
# bright_cyan. Use default or none to restore the built-in color.

#LAMA_OLE_COLOR_PROMPT=magenta        # built-in default
#LAMA_OLE_COLOR_THINKING=dim,bright_white
#LAMA_OLE_COLOR_OUTPUT=bright_white
#LAMA_OLE_COLOR_INPUT=bright_cyan
#LAMA_OLE_COLOR_METER_LOW=green       # < 70% usage
#LAMA_OLE_COLOR_METER_MID=yellow      # 70-90%
#LAMA_OLE_COLOR_METER_HIGH=red        # > 90%

# --------------------------------------------------------------------------
# 8. LSP code-intelligence tools
# --------------------------------------------------------------------------

# Override the built-in language-server table: a JSON object mapping a
# language id to a command + argv (the LLM never supplies commands).
#LAMA_OLE_LSP_SERVERS={"python": ["pylsp"], "rust": ["rust-analyzer"]}

# Root directory for LSP sessions (default: the working directory). No flag.
#LAMA_OLE_LSP_ROOT=/path/to/project

# Per-request timeout in seconds for LSP calls (default: 15).
#LAMA_OLE_LSP_TIMEOUT=15

# --------------------------------------------------------------------------
# 9. Media tools
# --------------------------------------------------------------------------

# Ollama host used by the vision/audio tools (defaults to --host). Set this
# if the media tools must talk to a different Ollama instance.
#LAMA_OLE_VISION_HOST=http://localhost:11434

# --------------------------------------------------------------------------
# 10. Opt-in extras
# --------------------------------------------------------------------------

# Enable the defensive entropy check on tool results (also on at -vv).
# Any non-empty value enables it.
#LAMA_OLE_ENTROPY_CHECK=1

# NOTE: test-gating switches (LAMA_OLE_HOST_LLAMACPP_INTEGRATION,
# LAMA_OLE_LSP_INTEGRATION, LAMA_OLE_ENFORCE_HELP_DEFAULTS) are NOT runtime
# config and are deliberately absent here — they are shell exports for the
# pytest suite and have no effect when placed in this file.
